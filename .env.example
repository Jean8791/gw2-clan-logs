# Copie para .env (que não vai para o git) e troque os valores.
DOMINIO=logs-do-cla.duckdns.org
# Senha para enviar logs. Passe para os membros do clã.
UPLOAD_KEY=troque-esta-senha
# Senha para marcar as guildas da aliança. Mantenha só com os administradores.
ADMIN_KEY=troque-esta-outra-senha
# Dias que as lutas ficam guardadas (0 = para sempre)
RETENTION_DAYS=7
