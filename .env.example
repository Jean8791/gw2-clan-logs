# ===== Obrigatórias =====
# Domínio público do site, sem https:// (o Caddy emite o certificado para ele)
DOMINIO=

# Aplicativo do Discord (portal de desenvolvedores): o login não sobe sem os dois
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ===== Quem pode entrar =====
# IDs de servidores do Discord, separados por vírgula: só quem está em um deles entra.
# A conferência vale por 7 dias; depois a sessão do navegador pede novo login.
DISCORD_GUILD_IDS=

# IDs de usuários do Discord, separados por vírgula: só eles entram.
# Com as duas listas preenchidas, valem juntas (precisa estar nas duas).
DISCORD_USER_IDS=

# Só "true" se quiser mesmo aceitar qualquer conta do Discord.
# Com as duas listas vazias e sem isto, o servidor não sobe.
ALLOW_ANY_DISCORD=

# ===== Administração (marcar as guildas da aliança com a estrela) =====
# IDs do Discord de quem administra pelo login, separados por vírgula
ADMIN_DISCORD_IDS=

# Alternativa para script, enviada no cabeçalho x-upload-key. Vazio = só pelo login.
# Gere uma longa e aleatória na máquina de uso; nunca coloque um valor real aqui.
ADMIN_KEY=

# ===== Segurança =====
# Dias de validade do token pessoal de envio (padrão 90); depois é preciso gerar outro no site
API_TOKEN_DAYS=

# Limite de pedidos por IP por minuto: geral (padrão 600) e login (padrão 30). 0 desliga.
RATE_LIMIT_PER_MIN=
RATE_LIMIT_AUTH_PER_MIN=

# ===== Dados e recursos =====
# Dias que as lutas ficam guardadas (padrão do compose: 30). 0 = guardar para sempre.
RETENTION_DAYS=

# Limite de memória do contêiner (padrão 1500m)
APP_MEM_LIMIT=
